# Firebase web config (gizli değildir, güvenlik Firestore Security Rules ile sağlanır —
# bkz. docs/decisions/0003-firestore-veri-modeli.md). Firebase Console > Proje Ayarları'ndan
# kopyalanır. Bu dosyayı .env olarak kopyalayıp gerçek değerleri gir; .env git'e eklenmez.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
